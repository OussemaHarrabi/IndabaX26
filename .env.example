# Local stack template. Copy to `.env` (gitignored) and set real values.
#
#   cp .env.example .env
#
# `compose.yaml` uses the `:?` interpolation form for every secret, so Compose
# refuses to start with an empty value rather than quietly using a weak default.
# Never commit `.env`, and never reuse the placeholder strings below outside a
# throwaway local run.

# --- API -----------------------------------------------------------------------
# Bind to loopback only. The service has no authentication by default (finding
# F1); publishing it to a routable interface is a deliberate, reviewed change.
AEGISGRAPH_BIND_ADDRESS=127.0.0.1
AEGISGRAPH_PORT=8080
AEGISGRAPH_LOG_LEVEL=info
# D5/D7: the unauthenticated legacy /v1/decision surface is OFF by default. Set
# this to `true` only for a loopback demo of that surface; the supported path is
# the authenticated /api/v1 API.
AEGISGRAPH_LEGACY_UNAUTHENTICATED=false

# --- PostgreSQL (M2 persistence; unused by the current API revision) -----------
POSTGRES_USER=aegisgraph
POSTGRES_PASSWORD=replace-with-a-generated-secret
POSTGRES_DB=aegisgraph

# --- Grafana -------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-generated-secret
